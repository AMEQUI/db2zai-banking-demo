//BNKEOD01 JOB (ACCT),'EOD POSTING',CLASS=A,MSGCLASS=X,NOTIFY=&SYSUID
//*===================================================================*
//* BATCH JOB: BNKEOD01 - EXECUTE CORE BANKING BATCH (BNK7100B)      *
//* PURPOSE  : EXECUTES PACKAGE COL_BANKING.BNK7100B VIA IKJEFT01    *
//*===================================================================*
//STEP01   EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DISP=SHR,DSN=DSN1310.SDSNLOAD
//         DD DISP=SHR,DSN=BANKING.LOADLIB
//DBRMLIB  DD DISP=SHR,DSN=BANKING.DBRMLIB
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSUDUMP DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2A)
  RUN PROGRAM(BNK7100B) PLAN(BANKPLAN) -
      LIB('BANKING.LOADLIB')
  END
/*
