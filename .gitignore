.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
auth.json

# ==============================================================================
# Web Simulation / Frontend Dependencies & Builds
# ==============================================================================
node_modules/
dist/
build/
.cache/
.parcel-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# Mainframe / z/OS & Zowe Tooling Artifacts
# ==============================================================================
# Zowe CLI & VS Code profiles/logs
.zowe/
zowe.config.json
zowe.schema.json
*.zowe.log

# Temporary compiler listings, listings, dumps, and spools
*.listing
*.lst
*.spool
*.dump
*.diag
*.xcom

# ==============================================================================
